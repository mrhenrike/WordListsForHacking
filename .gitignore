__pycache__/
*.pyc
.log/
.tmp/
.venv/
venv/

# Secrets & credentials — never commit
.env
.env.*
*.pem
*.ppk
*.key
*.p12
*.pfx
*.crt
id_rsa
id_rsa.*
*.credentials
credentials.json
secrets.json
**/secrets/

# Internal / local-only tooling (not for public distribution)
update_wordlists.py

# OSINT profiles, examples, local targets
examples/

# Temp / scratch / generated one-off wordlists
*.tmp.lst
temp/
/tmp/

# Modelo ML treinado (pode conter hash de dados sensíveis)
.model/

# Listas geradas pelo wfh.py (versionar apenas quando curadas)
generated/*.lst
generated/*.txt
!generated/.gitkeep

# PyPI build artifacts
dist/
build/
*.egg-info/
*.egg

# Lab folder: only root-level curated *.lst (passwords/users) are tracked.
# Subdirectories, YAML profiles, and generated lists stay local.
labs/*/
labs/*.yaml
labs/*.yml
labs/labs_number2text.lst
