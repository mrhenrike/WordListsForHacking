update_wordlists.py

# Main password corpus — tracked via Git LFS (see .gitattributes)

# OSINT YAML profiles live under labs/profiles/ (gitignored via labs/*/)

# Temp / scratch / generated one-off wordlists
*.tmp.lst
temp/
/tmp/

# Modelo ML treinado (pode conter hash de dados sensíveis)
.model/

# Listas geradas pelo wfh.py (versionar apenas quando curadas)
generated/*.lst
generated/*.txt
!generated/.gitkeep

# PyPI build artifacts
dist/
build/
*.egg-info/
*.egg

# Lab folder: only root-level curated *.lst (passwords/users) are tracked.
# Subdirectories, YAML profiles, and generated lists stay local.
labs/*/
labs/*.yaml
labs/*.yml
labs/labs_number2text.lst

